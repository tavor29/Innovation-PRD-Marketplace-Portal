# --- Database ---
DATABASE_URL=postgres://portal:portal@localhost:5432/portal

# --- Auth.js ---
AUTH_SECRET=change-me-in-production-use-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# Corporate SSO (leave empty to use dev credentials provider)
AUTH_ENTRA_ID=
AUTH_ENTRA_SECRET=
AUTH_ENTRA_ISSUER=

# --- AI provider (provider-agnostic registry) ---
# One of: mock | openai | azure | anthropic
AI_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4

# --- Storage adapter ---
# One of: local | s3 | azure | supabase
STORAGE_DRIVER=local
# On Vercel use /tmp/storage (the only writable folder; files there are temporary)
STORAGE_LOCAL_DIR=./.storage

# --- Background jobs ---
# inline (default) | queue (pg-boss; run `npm run worker`)
JOBS_MODE=inline

# --- Public demo ---
# Protects /api/demo/reset (nightly cron in vercel.json)
CRON_SECRET=
